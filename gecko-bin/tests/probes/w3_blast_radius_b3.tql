redefine
  fun blast-radius($r: memory-item) -> { memory-item }:
      match
          {
              rests-on (assumption: $r, resting: $m);
          } or {
              derivation (source: $r, derived: $m);
          } or {
              resolves (resolution-belief: $r, record-a: $c);
              population-member (owning-population: $pop, member: $c);
              scoped (scoped-belief: $m, population: $pop);
          } or {
              {
                  rests-on (assumption: $r, resting: $mid);
              } or {
                  derivation (source: $r, derived: $mid);
              };
              let $m in blast-radius($mid);
          };
      return { $m };
