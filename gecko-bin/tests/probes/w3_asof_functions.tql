define
  fun population-members-at($pop: population, $t: datetime) -> { concept } @doc("The members of a population as of time $t, read from the windowed materialized membership."):
      match
          $pm isa population-member, links (owning-population: $pop, member: $m);
          $pm has valid-from $vf; $vf <= $t;
          not { $pm has valid-to $vt; $vt <= $t; };
      return { $m };

  fun canonical-entity-at($rec: concept, $t: datetime) -> { concept } @doc("Transitive closure of source records resolved to the same entity as $rec as of time $t, following provable resolution beliefs whose validity window contains $t."):
      match
          {
              $res isa resolution, has valid-from $vf; $vf <= $t;
              not { $res has valid-to $vt; $vt <= $t; };
              derivation (derived: $res, source: $src), has derivation-method $dm;
              { $dm == "type-join"; } or { $dm == "cardinality"; } or { $dm == "functional-dependency"; };
              { resolves (resolution-belief: $res, record-a: $rec, record-b: $other); }
              or
              { resolves (resolution-belief: $res, record-a: $other, record-b: $rec); };
          } or {
              $res2 isa resolution, has valid-from $vf2; $vf2 <= $t;
              not { $res2 has valid-to $vt2; $vt2 <= $t; };
              derivation (derived: $res2, source: $src2), has derivation-method $dm2;
              { $dm2 == "type-join"; } or { $dm2 == "cardinality"; } or { $dm2 == "functional-dependency"; };
              { resolves (resolution-belief: $res2, record-a: $rec, record-b: $mid); }
              or
              { resolves (resolution-belief: $res2, record-a: $mid, record-b: $rec); };
              let $other in canonical-entity-at($mid, $t);
          };
      return { $other };
