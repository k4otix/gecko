redefine
  fun blast-radius($r: okf-concept) -> { memory-item }:
      match
          {
              rests-on (assumption: $r, resting: $m);
          } or {
              derivation (source: $r, derived: $m);
          } or {
              population-member (owning-population: $pop, member: $r);
              scoped (scoped-belief: $m, population: $pop);
          } or {
              { rests-on (assumption: $r, resting: $mid); }
              or { derivation (source: $r, derived: $mid); }
              or { population-member (owning-population: $pop2, member: $r);
                   scoped (scoped-belief: $mid, population: $pop2); };
              let $m in blast-radius($mid);
          };
      return { $m };
