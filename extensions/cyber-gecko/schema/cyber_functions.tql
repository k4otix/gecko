# techniques with NO asserted detection claim — the coverage gap list
fun undetected-techniques() -> { attack-pattern }:
    match
        $t isa attack-pattern;
        not { ($t) isa technique-detection, links (detection-claim: $b);
              $b has belief-state "asserted"; };
    return { $t };

# detections whose required evidence has NO covering sensor — blinded logic
fun blinded-detections() -> { concept }:
    match
        (detecting-logic: $d, detected-technique: $t, detection-claim: $b) isa technique-detection;
        $b has belief-state "asserted";
        (technique: $t, required: $comp) isa requires-evidence;
        not { (covering-sensor: $s, covered-component: $comp) isa sensor-coverage; };
    return { $d };
