define

  # ── Mem-GECKO Attributes ──────────────────────────────────────────  
  attribute confidence-score value double;             
  attribute verification-status value string @values("provisional", "verified", "falsified");
  attribute resolution-strategy value string;          
  attribute priority-level value integer;  
  attribute execution-status value string @values("pending", "active", "suspended", "completed", "failed");
  attribute epistemic-weight value double;    
  attribute supersession-reason value string;
  attribute agent-rationale value string;
  attribute execution-id value string;
  attribute verdict-result value string;
  attribute condition value string;

  # ── Temporal Attributes ──────────────────────────────────────────
  attribute valid-from value datetime;
  attribute valid-until value datetime;
  attribute half-life-hours value double;
  attribute last-recalled value datetime;
  attribute deadline value datetime;
  attribute duration-ms value integer;

  # ── Mem-GECKO Cognitive Nodes ──────────────────────────────────────
  entity concept,
      plays contextualizes:target-entity;

  entity cognitive-node sub concept,
      owns confidence-score @card(0..1),
      owns last-recalled @card(0..1);

  entity hypothesis sub cognitive-node,
      owns verification-status @card(1),
      plays corroboration:supported-claim,
      plays falsification:disproven-claim,
      plays deprecation:deprecated-node;

  entity semantic-belief sub cognitive-node,
      owns valid-from @card(0..1),
      owns valid-until @card(0..1),
      plays corroboration:supported-claim,
      plays falsification:disproven-claim,
      plays contradiction:conflicting-claim,
      plays deprecation:deprecated-node,
      plays deprecation:superseding-node;

  entity anomaly sub cognitive-node,
      owns resolution-strategy @card(0..1),
      plays contradiction:conflict-context;

  entity intention sub cognitive-node,
      owns priority-level @card(0..1),
      owns execution-status @card(1),
      owns deadline @card(0..1),
      plays goal-hierarchy:parent-goal,
      plays goal-hierarchy:child-goal,
      plays context-link:driving-intention;
      
  entity execution-episode sub cognitive-node,
      owns execution-id @key,
      owns verdict-result @card(0..1),
      owns agent-rationale @card(0..1),
      owns half-life-hours @card(0..1),
      owns duration-ms @card(0..1),
      plays corroboration:supporting-evidence,
      plays falsification:counter-evidence,
      plays generalizes-into:source-episode,
      plays context-link:linked-episode,
      plays contextualizes:episode;

  entity learned-constraint sub cognitive-node,
      owns condition @card(0..1),
      plays generalizes-into:generalized-concept,
      plays deprecation:deprecated-node,
      plays deprecation:superseding-node,
      plays falsification:disproven-claim;

  # ── Mem-GECKO Cognitive Links ──────────────────────────────────────
  relation cognitive-link @abstract, sub okf-link;

  relation corroboration sub cognitive-link,
      relates supporting-evidence as source,
      relates supported-claim as target,
      owns epistemic-weight @card(0..1);

  relation falsification sub cognitive-link,
      relates counter-evidence as source,
      relates disproven-claim as target,
      owns epistemic-weight @card(0..1);

  relation contradiction sub cognitive-link,
      relates conflicting-claim as source,
      relates conflict-context as target;

  relation deprecation sub cognitive-link,
      relates superseding-node as source,
      relates deprecated-node as target,
      owns supersession-reason @card(0..1),
      owns timestamp @card(1);

  relation generalizes-into sub cognitive-link,
      relates source-episode as source,
      relates generalized-concept as target;

  relation goal-hierarchy sub cognitive-link,
      relates parent-goal as source,
      relates child-goal as target;

  relation context-link sub cognitive-link,
      relates driving-intention as source,
      relates linked-episode as target;

  # Polymorphically links to any okf-concept subtype (retaining from old schema)
  relation contextualizes sub okf-link,
    relates episode as source,
    relates target-entity as target;

  # ── Deductive Functions (ATMS) ─────────────────────────────────────
  
  # Evaluates if ANY cognitive node has been structurally superseded or falsified
  fun is-superseded($node: cognitive-node) -> boolean:  
      match   
          {   
              (deprecated-node: $node, superseding-node: $newer-node) isa deprecation;
          }   
          or   
          {   
              (disproven-claim: $node, counter-evidence: $counter-evidence) isa falsification;
          };  
      return check;

  # Extracts a rigorously filtered subset of valid, uncontradicted beliefs
  fun active-semantic-beliefs() -> { semantic-belief }:  
      match   
          $b isa semantic-belief;  
          not { true == is-superseded($b); };  
      return { $b };

  # Extracts active learned constraints
  fun active-learned-constraints() -> { learned-constraint }:
      match
          $c isa learned-constraint;
          not { true == is-superseded($c); };
      return { $c };

  # ── Intentionality & Prospective Memory ──
  
  # Retrieves all intentions that the agent is actively pursuing
  fun active-intentions() -> { intention }:
      match 
          $i isa intention, has execution-status "active";
      return { $i };

  # Retrieves intentions waiting to be started
  fun pending-intentions() -> { intention }:
      match 
          $i isa intention, has execution-status "pending";
      return { $i };

  # Recursively fetches the ultimate root goal for a given intention
  fun root-goal($child: intention) -> { intention }:
      match
          {
              not { (child-goal: $child) isa goal-hierarchy; };
              $root is $child;
          }
          or
          {
              (parent-goal: $root, child-goal: $child) isa goal-hierarchy;
              not { (child-goal: $root) isa goal-hierarchy; };
          }
          or
          {
              (parent-goal: $parent, child-goal: $child) isa goal-hierarchy;
              let $root in root-goal($parent);
          };
      return { $root };

  # ── Conflict & Anomaly Management ──

  # Retrieves anomalies that do not yet have a recorded resolution strategy
  fun unresolved-anomalies() -> { anomaly }:
      match
          $a isa anomaly;
          not { $a has resolution-strategy $strategy; };
      return { $a };

  # ── Epistemic Provenance & Corroboration ──

  # Fetches all corroborating episodes for a given hypothesis (for host-engine weight calculation)
  fun corroboration-cluster($claim: hypothesis) -> { execution-episode }:
      match
          (supported-claim: $claim, supporting-evidence: $evidence) isa corroboration;
      return { $evidence };

  # Fetches immediate foundational evidence for a semantic belief
  fun foundational-evidence($belief: semantic-belief) -> { execution-episode }:
      match
          (supported-claim: $belief, supporting-evidence: $episode) isa corroboration;
      return { $episode };
